# Cadena de conexión a Supabase (Postgres). Obtenerla desde Project Settings > Database.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Secreto para firmar los JWT de sesión del panel admin. Generar uno propio, no usar este valor.
JWT_SECRET="reemplazar-por-un-valor-aleatorio-largo"

# Stripe (modo de prueba). Clave secreta desde Developers > API keys; nunca se sube al repo.
STRIPE_SECRET_KEY="sk_test_..."

# URL del frontend, a donde Stripe devuelve al cliente tras pagar o cancelar.
FRONTEND_URL="http://localhost:5173"

# Secreto para verificar los webhooks. En local sale de `stripe listen`; en Render, del endpoint del dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."
